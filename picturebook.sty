% ============================================================
%  picturebook.sty
%  A LaTeX package for illustrated children's picture books.
%  Engine: LuaLaTeX  (compile with: lualatex main.tex)
%
%  Package options:
%    debug       - show grid overlay, safe area, page type labels
%    safemargin  - safe area margin (default 5mm)
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{picturebook}[2026/03/12 Illustrated children's picture book template]

% ------------------------------------------------------------
%  Option handling
% ------------------------------------------------------------
\newif\ifpb@debug
\pb@debugfalse

\newif\ifpb@pagenumbers
\pb@pagenumbersfalse

\newlength{\pb@safemargin}
\setlength{\pb@safemargin}{5mm}

% Page number style: "sides" (left/right) or "center"
\def\pb@pagenumberstyle{sides}

\DeclareOption{debug}{\pb@debugtrue}
\DeclareOption{pagenumbers}{\pb@pagenumberstrue}
\DeclareOption*{\PackageWarning{picturebook}{Unknown option '\CurrentOption'}}
\ProcessOptions\relax

% ------------------------------------------------------------
%  Required packages
% ------------------------------------------------------------
\RequirePackage[paperwidth=148mm, paperheight=210mm, margin=0mm]{geometry}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{fontspec}
\RequirePackage{polyglossia}
\RequirePackage[absolute,overlay]{textpos}
\RequirePackage{xcolor}
\RequirePackage{environ}
\RequirePackage{fancyhdr}
\RequirePackage{etoolbox}

% Suppress headers/footers by default
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% ============================================================
%  PAGE NUMBERS (R13)
%  Enabled via \pagenumberson or the 'pagenumbers' package option.
%  Disabled via \pagenumbersoff (e.g., for a clean spread).
%  Style: \pagenumberstyle{sides} or \pagenumberstyle{center}
% ============================================================
\newcommand{\pagenumberson}{\pb@pagenumberstrue}
\newcommand{\pagenumbersoff}{\pb@pagenumbersfalse}
\newcommand{\pagenumberstyle}[1]{\def\pb@pagenumberstyle{#1}}

% Render page number as TikZ overlay (works over full-bleed images)
\newcommand{\pb@renderpagenum}{%
  \ifpb@pagenumbers
    \begin{tikzpicture}[remember picture, overlay]
      \def\pb@pnstyle{\pb@pagenumberstyle}%
      \ifx\pb@pnstyle\pb@style@center
        % Centered at bottom
        \node[fill=white, fill opacity=0.5, text opacity=1,
              inner sep=3pt, rounded corners=2pt, anchor=south,
              font=\small\sffamily]
          at ([yshift=8mm]current page.south) {\thepage};
      \else
        % Sides: left on even pages, right on odd pages
        \ifodd\value{page}
          \node[fill=white, fill opacity=0.5, text opacity=1,
                inner sep=3pt, rounded corners=2pt, anchor=south east,
                font=\small\sffamily]
            at ([xshift=-8mm, yshift=8mm]current page.south east) {\thepage};
        \else
          \node[fill=white, fill opacity=0.5, text opacity=1,
                inner sep=3pt, rounded corners=2pt, anchor=south west,
                font=\small\sffamily]
            at ([xshift=8mm, yshift=8mm]current page.south west) {\thepage};
        \fi
      \fi
    \end{tikzpicture}%
  \fi
}
\def\pb@style@center{center}

% Configure textpos to use centimeters from top-left origin
\setlength{\TPHorizModule}{1cm}
\setlength{\TPVertModule}{1cm}
\textblockorigin{0cm}{0cm}

% Store original geometry for switching modes
\newlength{\pb@pageW}
\newlength{\pb@pageH}
\setlength{\pb@pageW}{\paperwidth}
\setlength{\pb@pageH}{\paperheight}


% ============================================================
%  TRANSLATION SYSTEM (Lua tables)
% ============================================================

% \booklang must be defined before \input{main}
% e.g. \def\booklang{ro}
\ifdefined\booklang\else
  \def\booklang{ro}
\fi

% Load translations with fallback chain:
%   1. Start with Romanian (primary/source language) as the base table.
%   2. Overlay the target language on top.
%   3. Keys present in target -> use target value.
%      Keys missing in target -> keep Romanian value, prefixed with [TODO] in
%      the compiled output so translators can spot untranslated strings.
%
% This means:
%   - Compilation always succeeds regardless of missing keys.
%   - Translators see the Romanian source text as context, not a blank.
%   - [TODO] markers are visible in the PDF so nothing silently slips through.
\directlua{
  local primary = "ro"
  local lang    = "\booklang"

  local base = dofile("translations/" .. primary .. ".lua") or {}

  local overlay = {}
  if lang ~= primary then
    overlay = dofile("translations/" .. lang .. ".lua") or {}
    if not next(overlay) then
      texio.write_nl("WARNING: translations/" .. lang .. ".lua not found or empty")
    end
  end

  pb_strings = {}
  pb_fallback_keys = {}

  for k, v in pairs(base) do
    if overlay[k] ~= nil then
      pb_strings[k] = overlay[k]
    else
      pb_strings[k] = v
      if lang ~= primary and k ~= "polyglossia_lang" then
        pb_fallback_keys[k] = true
      end
    end
  end
  for k, v in pairs(overlay) do
    if pb_strings[k] == nil then
      pb_strings[k] = v
    end
  end
}

% \tr{key} — retrieve a translated string.
%   - Key present in target language  -> render normally.
%   - Key missing in target, present in Romanian -> render with [TODO] prefix.
%   - Key missing everywhere          -> render "MISSING: key" in red.
% Newlines: blank line -> \par, single newline -> space.
\newcommand{\tr}[1]{%
  \directlua{
    local key = "\luaescapestring{#1}"
    local val = pb_strings[key]
    if val then
      local CR = string.char(13)
      local LF = string.char(10)
      val = val:gsub(CR .. LF, LF):gsub(CR, LF)
      val = val:gsub(LF .. LF .. "+", "\\par ")
      val = val:gsub(LF, " ")
      if pb_fallback_keys[key] then
        tex.sprint("\\textcolor{orange}{[TODO] }" .. val)
      else
        tex.sprint(val)
      end
    else
      tex.sprint("\\textcolor{red}{MISSING: " .. key .. "}")
    end
  }%
}

% Set polyglossia language from the Lua table
\directlua{
  local lang = pb_strings and pb_strings["polyglossia_lang"]
  if lang then
    tex.print("\\setmainlanguage{" .. lang .. "}")
  else
    tex.print("\\setmainlanguage{english}")
  end
}


% ============================================================
%  DUAL-LANGUAGE SYSTEM (additive — does not affect single-language builds)
%
%  A dual-language book renders two languages stacked in the same text
%  block: the primary (\booklang) on top, the secondary (\booklangsecondary)
%  below it in its own typographic style and Polyglossia language context.
%
%  Activated ONLY when \booklangsecondary is defined before \input.
%  When it is undefined, none of the following has any effect and the
%  single-language behaviour above is fully preserved.
%
%    \def\booklang{ro}            % primary   (top)
%    \def\booklangsecondary{en}   % secondary (bottom)
%
%  The secondary table is built independently from pb_strings, using the
%  same Romanian-source fallback: a key missing in the secondary language
%  falls back to the Romanian source text, flagged with [TODO], rather than
%  rendering "MISSING". This keeps dual builds as robust as single ones.
% ============================================================
% Determine the secondary language code (empty if none) at the TeX level,
% BEFORE entering \directlua. \pb@seccode expands to e.g. "en" or to nothing.
\ifdefined\booklangsecondary
  \edef\pb@seccode{\booklangsecondary}%
\else
  \def\pb@seccode{}%
\fi
% Catcode guard: by the time these \directlua blocks run, \setmainlanguage{...}
% (emitted above) may have made " and ~ active characters (polyglossia
% shorthands for German/Russian etc.). Inside \directlua an active " would
% break Lua string delimiters, and an active ~ would break Lua's ~= operator
% (the symptom is a spurious "'then' expected near '\'" from the chunk).
% Force both to catcode 12 (other) for the duration of each chunk. The
% earlier primary loader escapes this only because it runs before any
% language is selected.
\begingroup
\catcode`\"=12\relax
\catcode`\~=12\relax
\directlua{
  local primary = "ro"
  local sec = "\luaescapestring{\pb@seccode}"

  pb_strings_secondary = nil
  pb_fallback_keys_secondary = {}

  if sec ~= "" then
    local base = dofile("translations/" .. primary .. ".lua") or {}
    local overlay = {}
    if sec ~= primary then
      overlay = dofile("translations/" .. sec .. ".lua") or {}
      if not next(overlay) then
        texio.write_nl("WARNING: secondary translations/" .. sec ..
                       ".lua not found or empty")
      end
    end

    pb_strings_secondary = {}
    for k, v in pairs(base) do
      if overlay[k] ~= nil then
        pb_strings_secondary[k] = overlay[k]
      else
        pb_strings_secondary[k] = v
        if sec ~= primary and k ~= "polyglossia_lang" then
          pb_fallback_keys_secondary[k] = true
        end
      end
    end
    for k, v in pairs(overlay) do
      if pb_strings_secondary[k] == nil then
        pb_strings_secondary[k] = v
      end
    end
  end
}%
\endgroup

% Register the secondary Polyglossia language (for correct hyphenation /
% typographic rules of the secondary text). No-op when no secondary table.
%
% Two-step, and the split matters:
%   1. Inside a catcode group (to protect the Lua chunk's " and ~), run
%      \directlua only to STASH the secondary polyglossia language name into
%      the global macro \pb@seclang.
%   2. AFTER closing the group, call \setotherlanguage{\pb@seclang}. This must
%      happen at top level: \setotherlanguage defines the language environment
%      via \newenvironment, which would be local — and thus discarded by
%      \endgroup — if it ran inside the group.
\begingroup
\catcode`\"=12\relax
\catcode`\~=12\relax
\directlua{
  if pb_strings_secondary then
    local lang = pb_strings_secondary["polyglossia_lang"] or "english"
    tex.print("\\gdef\\pb@seclang{" .. lang .. "}")
  end
}%
\endgroup
\ifdefined\pb@seclang
  \setotherlanguage{\pb@seclang}%
\fi

% ---- Customisation hooks (override in the preamble if desired) ----
% \dualsecstyle — how the secondary (lower) language is typeset.
% \dualsep      — vertical separation between primary and secondary.
\providecommand{\dualsecstyle}{\small\itshape}
\providecommand{\dualsep}{\par\medskip}

% Internal: render a key from the secondary table, with the same
% newline handling and [TODO] fallback marking as \tr.
\newcommand{\pb@trsecondary}[1]{%
  \directlua{
    local key = "\luaescapestring{#1}"
    local val = pb_strings_secondary and pb_strings_secondary[key]
    if val then
      local CR = string.char(13)
      local LF = string.char(10)
      val = val:gsub(CR .. LF, LF):gsub(CR, LF)
      val = val:gsub(LF .. LF .. "+", "\\par ")
      val = val:gsub(LF, " ")
      val = val:gsub("ț", "ţ"):gsub("Ț", "Ţ")
      if pb_fallback_keys_secondary[key] then
        tex.sprint("\\textcolor{orange}{[TODO] }" .. val)
      else
        tex.sprint(val)
      end
    else
      tex.sprint("\\textcolor{red}{MISSING: " .. key .. "}")
    end
  }%
}

% \dualtr{key} — primary on top, secondary stacked below.
% Falls back to plain \tr{key} when no secondary language is loaded, so the
% same source can compile single- or dual-language without edits.
\newcommand{\dualtr}[1]{%
  \ifdefined\pb@seclang
    \tr{#1}%
    \dualsep
    {\dualsecstyle
     \begin{\pb@seclang}\pb@trsecondary{#1}\end{\pb@seclang}}%
  \else
    \tr{#1}%
  \fi
}


% ============================================================
%  FONT CONFIGURATION
% ============================================================
% Default font: Linux Libertine O (supports Latin + Cyrillic)
% Override by defining \bookfont before loading the package:
%   \def\bookfont{Antykwa Torunska}          % system-installed font
%   \def\bookfont{OpenDyslexic}              % font in fonts/ subdir
%   \def\bookfontpath{fonts/opendyslexic/}   % required when not system-installed
\ifdefined\bookfont\else
  \def\bookfont{Linux Libertine O}
\fi
\ifdefined\bookfontpath
  \setmainfont{\bookfont}[Path=\bookfontpath,
    Extension      = .otf,
    UprightFont    = *-Regular,
    BoldFont       = *-Bold,
    ItalicFont     = *-Italic,
    BoldItalicFont = *-Bold-Italic]
\else
  \setmainfont{\bookfont}
\fi
% Some older fonts (e.g. Antykwa Torunska) have t/T-cedilla (U+0163/0162)
% but not t/T-comma-below (U+021B/021A), the correct Romanian codepoints.
% pre_shaping_filter fires before HarfBuzz shapes each glyph run, so the
% remapped codepoint is what HarfBuzz receives — no phantom cluster markers,
% no spurious spaces, no missing-character warnings.
\directlua{
  local glyph_id = node.id("glyph")
  local font_lacks_cache = {}
  local function font_lacks(fid, cp)
    local key = fid * 0x200000 + cp
    local v = font_lacks_cache[key]
    if v == nil then
      local f = font.getfont(fid)
      v = not (f and f.characters and f.characters[cp])
      font_lacks_cache[key] = v
    end
    return v
  end
  local function remap_romanian_comma(head)
    for n in node.traverse_id(glyph_id, head) do
      if n.char == 0x021B and font_lacks(n.font, 0x021B) then
        n.char = 0x0163
      elseif n.char == 0x021A and font_lacks(n.font, 0x021A) then
        n.char = 0x0162
      end
    end
    return head
  end
  if luatexbase.callback_types and
     luatexbase.callback_types["pre_shaping_filter"] then
    luatexbase.add_to_callback(
      "pre_shaping_filter", remap_romanian_comma, "pb_remap_romanian_comma")
  else
    texio.write_nl(
      "WARNING (picturebook): pre_shaping_filter unavailable (LuaTeX < 1.15)." ..
      " Using translation-output fallback for Romanian ț/Ț.")
  end
}
% Polyglossia requires all font families to support the active script.
% Set sans and mono to Cyrillic-capable fonts as well.
\setsansfont{Linux Biolinum O}
\setmonofont{FreeMono}


% ============================================================
%  INTERNAL: Full-bleed geometry reset
% ============================================================
\newcommand{\pb@resetbleed}{%
  \clearpage
  \newgeometry{margin=0mm}%
  \thispagestyle{fancy}%
}


% ============================================================
%  \startprose — switch to standard margins for prose sections.
%  No \endprose needed; \singlepage / \fullspread reset to full-bleed.
% ============================================================
\newcommand{\startprose}{%
  \clearpage
  \newgeometry{margin=20mm, bottom=25mm}%
  % For prose pages, use fancyhdr footer for page numbers
  \fancyhf{}%
  \ifpb@pagenumbers
    \fancyfoot[C]{\small\sffamily\thepage}%
  \fi
  \thispagestyle{fancy}%
  \pagestyle{fancy}%
}


% ============================================================
%  \singlepage{image}{x}{y}{width}{content}
%  Places a full-bleed background image with a text block.
%  x,y in cm from top-left. width in cm.
% ============================================================
\newcommand{\singlepage}[5]{%
  \pb@resetbleed
  % Background image
  \begin{tikzpicture}[remember picture, overlay]
    \node[inner sep=0pt, anchor=center] at (current page.center)
      {\includegraphics[width=\paperwidth, height=\paperheight]{#1}};
  \end{tikzpicture}%
  % Debug overlay
  \ifpb@debug\pb@drawdebug{SINGLE PAGE}\fi
  % Text block
  \begin{textblock*}{#4cm}(#2cm, #3cm)
    #5
  \end{textblock*}%
  % Page number
  \pb@renderpagenum
}


% ============================================================
%  \block{x}{y}{width}{content}
%  Places an additional text block on the current page.
%  Call immediately after \singlepage or \fullspread (before
%  the next page macro).  x, y, width in cm from top-left.
%  May be called multiple times for multiple extra blocks.
% ============================================================
\newcommand{\block}[4]{%
  \begin{textblock*}{#3cm}(#1cm, #2cm)
    #4
  \end{textblock*}%
}


% ============================================================
%  DEBUG OVERLAY
% ============================================================
\newcommand{\pb@drawdebug}[1]{%
  \begin{tikzpicture}[remember picture, overlay]
    % 1cm grid
    \draw[cyan!30, very thin, step=1cm]
      (current page.south west) grid (current page.north east);
    % 5cm coordinate labels
    \pgfmathsetmacro{\xmax}{int(\the\paperwidth / 28.45274)}% paperwidth in cm (approx)
    \pgfmathsetmacro{\ymax}{int(\the\paperheight / 28.45274)}% paperheight in cm
    \foreach \x in {0,5,...,\xmax} {
      \foreach \y in {0,5,...,\ymax} {
        \node[fill=black, fill opacity=0.5, text=white, text opacity=1,
              font=\ttfamily\fontsize{5}{6}\selectfont, inner sep=1pt,
              anchor=north west]
          at ([xshift=\x cm, yshift=-\y cm]current page.north west)
          {\x,\y};
      }
    }
    % Safe area (red dotted)
    \draw[red, thick, densely dotted]
      ([shift={(\pb@safemargin,\pb@safemargin)}]current page.south west)
      rectangle
      ([shift={(-\pb@safemargin,-\pb@safemargin)}]current page.north east);
    % Page type label
    \node[fill=black, fill opacity=0.7, text=white, text opacity=1,
          font=\ttfamily\scriptsize, inner sep=3pt, anchor=north west]
      at ([xshift=2mm, yshift=-2mm]current page.north west)
      {#1 ~|~ p.\thepage};
  \end{tikzpicture}%
}


% ============================================================
%  HALO ENVIRONMENT
%  Usage: \begin{halo}[color=white, opacity=0.6] ... \end{halo}
%  Places content over a semi-transparent rounded box for readability.
% ============================================================
\RequirePackage[most]{tcolorbox}

\pgfkeys{
  /pb/halo/.cd,
  color/.initial=white,
  opacity/.initial=0.6,
}

\newenvironment{halo}[1][]{%
  \pgfkeys{/pb/halo/.cd, #1}%
  \pgfkeysgetvalue{/pb/halo/color}{\pb@halo@color}%
  \pgfkeysgetvalue{/pb/halo/opacity}{\pb@halo@opacity}%
  \begin{tcolorbox}[
    enhanced,
    colback=\pb@halo@color,
    opacityback=\pb@halo@opacity,
    colframe=\pb@halo@color,
    opacityframe=0,
    boxrule=0pt,
    arc=4pt,
    boxsep=4pt,
    left=4pt, right=4pt, top=4pt, bottom=4pt,
    sharp corners=south,
    sharp corners=north,
    arc=4pt,
  ]%
}{%
  \end{tcolorbox}%
}


% ============================================================
%  PARITY ENFORCEMENT + FILLER PAGES (R15)
% ============================================================

% \fillerpage — intentional blank/decorative page.
% The author can call this explicitly to pad the page count.
\newcommand{\fillerpage}{%
  \pb@resetbleed
  \begin{tikzpicture}[remember picture, overlay]
    \fill[orange!30] (current page.south west) rectangle (current page.north east);
    \node[font=\Large\sffamily\bfseries, text=orange!70!black,
          align=center, anchor=center]
      at (current page.center)
      {THIS PAGE INTENTIONALLY LEFT BLANK\\[4pt]
       \normalsize\normalfont (filler page — p.\thepage)};
  \end{tikzpicture}%
  \ifpb@debug\pb@drawdebug{FILLER PAGE}\fi
  \pb@renderpagenum
}

% Internal: draw the auto-filler content (no \clearpage — caller handles that).
\newcommand{\pb@drawautofiller}{%
  \newgeometry{margin=0mm}%
  \thispagestyle{fancy}%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[orange!50] (current page.south west) rectangle (current page.north east);
    \node[font=\Large\sffamily\bfseries, text=orange!90!black,
          align=center, anchor=center]
      at (current page.center)
      {AUTO-INSERTED FILLER PAGE\\[4pt]
       \normalsize\normalfont A spread needed an even left page.\\
       Replace this with content or a \texttt{\textbackslash fillerpage}.\\[4pt]
       (p.\thepage)};
  \end{tikzpicture}%
  \ifpb@debug\pb@drawdebug{AUTO FILLER}\fi
  \pb@renderpagenum
}


% ============================================================
%  \fullspread{image}{Lx}{Ly}{Lwidth}{L-content}{Rx}{Ry}{Rwidth}{R-content}
%  Places a full-spread image across two pages (left + right).
%  The image is assumed to have 2:1 aspect ratio matching the spread.
%  L/R x,y in cm from top-left of each page. L/R width in cm.
%  Either content can be empty ({}).
%
%  Parity enforcement (R15): The left page of a spread MUST be even.
%  If the current page counter is odd, an auto-filler page is inserted.
% ============================================================
\newcommand{\fullspread}[9]{%
  % --- PARITY CHECK ---
  % After \pb@resetbleed (\clearpage), the page counter will be
  % on the next page. We need the left page to be even.
  % Check before clearpage: after clearpage, \thepage = next page number.
  \clearpage
  \ifodd\value{page}%
    % Current page is odd — insert a filler to push the
    % left page of the spread onto an even page number.
    \pb@drawautofiller
  \fi
  % --- LEFT PAGE ---
  \pb@resetbleed
  % Clip left half of the image
  \begin{tikzpicture}[remember picture, overlay]
    \clip (current page.south west) rectangle (current page.north east);
    \node[inner sep=0pt, anchor=west] at (current page.west)
      {\includegraphics[height=\paperheight, width=2\paperwidth]{#1}};
  \end{tikzpicture}%
  \ifpb@debug\pb@drawdebug{SPREAD LEFT}\fi
  \begin{textblock*}{#4cm}(#2cm, #3cm)
    #5
  \end{textblock*}%
  \pb@renderpagenum
  % --- RIGHT PAGE ---
  \pb@resetbleed
  % Clip right half of the image
  \begin{tikzpicture}[remember picture, overlay]
    \clip (current page.south west) rectangle (current page.north east);
    \node[inner sep=0pt, anchor=east] at (current page.east)
      {\includegraphics[height=\paperheight, width=2\paperwidth]{#1}};
  \end{tikzpicture}%
  \ifpb@debug\pb@drawdebug{SPREAD RIGHT}\fi
  \begin{textblock*}{#8cm}(#6cm, #7cm)
    #9
  \end{textblock*}%
  \pb@renderpagenum
}


% ============================================================
%  END OF PACKAGE
% ============================================================
\endinput
